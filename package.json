{
  "name": "github-asana",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "description": "Action to integrate git with asana",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "test": "node --env-file-if-exists=.env --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "package": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js --legal-comments=external --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\"",
    "generate-openapi": "pnpm dlx openapi-typescript@7.13.0 https://raw.githubusercontent.com/Asana/openapi/master/defs/asana_oas.yaml -o src/asana-openapi-schema.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhaasha/github-asana-action.git"
  },
  "keywords": [
    "github-actions",
    "asana",
    "git"
  ],
  "author": "Ali Sajid, Earlyworks Co., Ltd.",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bhaasha/github-asana-action/issues"
  },
  "homepage": "https://github.com/bhaasha/github-asana-action#readme",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "asana": "3.2.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
