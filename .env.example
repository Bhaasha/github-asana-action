# Optional. `pnpm test` runs against an in-process stub of the Asana API by
# default, so it needs none of this. Copy this file to `.env` and fill all three
# in to run the same suite against real Asana instead.
#
# Setting only some of them is an error, so the suite can't silently fall back
# to the stub when you meant to hit the real API.

# A personal access token: https://app.asana.com/0/my-apps
ASANA_PAT=

# The gid of a scratch project the tests may create and delete tasks in. It must
# be named "Asana bot test environment" and contain:
#   - sections named "New" and "Done"
#   - a number custom field named "Custom Number"
#   - an enum custom field named "Custom Enum" with an "OK" option
# Take the gid from the project url, e.g.
# https://app.asana.com/1/<organization>/project/<project>/... -> <project>
ASANA_PROJECT_ID=

# The gid of the workspace/organization the project lives in, the <organization>
# segment of the same url. Only used to build the new-format asana links the
# tests feed to the action.
ASANA_ORGANIZATION_ID=
